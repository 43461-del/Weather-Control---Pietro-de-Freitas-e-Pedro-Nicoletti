* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
    scroll-behavior: smooth;
}

body {
    background: #071426;
    color: white;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 8%;
    background: #0b1d35;
}

.logo {
    font-size: 23px;
    font-weight: bold;
    color: #35c9ff;
}

nav a {
    color:white;
    text-decoration: none;
    margin-left: 25px;
    transition: 0.3s;
}

nav a:hover{
    color:#35c9ff;
}

.hero {
    min-height: 450px;
    display: flex;
    align-items: center;
    padding: 80px 10%;
    background:
    linear-gradient(90deg,#071426 20%, transparent),
    url("https://images.unsplash.com/photo-1534088568595-a066f410bcda")
    center/cover;
}

.hero h1{
    font-size: 48px;
    color: #35c9ff;
    margin-bottom: 10px;
}

.hero h2 {
    font-size: 28px;
    margin-bottom: 20px;
}

.hero p {
    max-width: 500px;
    line-height: 1.7;
    color: #050e1b;
}

.botao {
    display: inline-block;
    margin-top: 25px;
    padding: 14px 28px;
    background: #16a9e0;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    transition: 0.3s;
}

.botao:hover {
    background: #0878ae;
}

.monitoramento,
.simulacao,
.sobre{
    padding: 70px 8%;
    text-align: center;
}

.monitoramento h2,
.simulacao h2,
.sobre h2 {
    font-size: 32px;
    color: #35c9ff;
    margin-bottom: 15px;
}

.subtitulo {
    color: #b4c7d9;
    margin-bottom: 35px;
}

.cards {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 20px; 
    margin-top: 40px;
}

.card {
    background: #102945;
    padding: 30px 15px;
    border-radius: 15px;
    border: 1px solid #1c5274;
    transition: 0.35;
}

.card:hover {
    transform: translate(-8px);
    border-color: #35c9ff;
}

.card span {
    font-size: 40px;
}

.card h3 {
    margin: 15px 0;
}

.valor {
    font-size: 30px;
    font-weight: bold;
    color: #35c9ff;
    margin-bottom: 10px;
}

.card small {
    color: #b4c7d9;
}

.simulacao {
    background: #16a9e0;
}

.simulador-box {
    max-width: 500px;
    margin: 30px auto;
    padding: 35px;
    background: #102945;
    border-radius: 15px;
}

select,
button {
    display: block;
    width: 100%;
    padding: 13px;
    margin-top: 15px;
    border-radius: 8px;
    border: none;
    font-size: 16px;
}

button {
    background: #16a9e0;
    color: white;
    cursor: pointer;
    transition: 0.3s;
}

button:hover {
    background: #0878ae;
}

#resultado {
    margin-top: 25px;
    padding: 20px;
    background: #071426;
    border-radius: 10px;
    line-height: 2;
}

.sobre p {
    max-width: 800px;
    margin: 20px auto;
    line-height: 1.8;
    color: #c5d5e5;
}

footer {
    background: #050e1b;
    text-align: center;
    padding: 25px;
    color: #9eb5c9;
    line-height: 2;
}

@media (max-width: 850px) {
    .cards {
        grid-template-columns: repeat(2, 1fr);
    }

    header{
        flex-direction: column;
        gap: 20px;
    }
    nav a {
        margin-top: 8px;
    }
}
@media (max-width: 500px) {
    .cards {
        grid-template-columns: lfr;
    }

    .hero h1 {
        font-size: 35px;
    }

    nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
    }
}